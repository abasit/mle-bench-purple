# ============================================================
#  LLM configuration  ← edit these
# ============================================================
agent:
  code:
    model: Qwen/Qwen3-Coder-480B-A35B-Instruct
    temp: 1
    base_url: "https://api.tokenfactory.nebius.com/v1"
    api_key: ""
  feedback:
    model: Qwen/Qwen3-Coder-480B-A35B-Instruct
    temp: 1
    base_url: "https://api.tokenfactory.nebius.com/v1"
    api_key: ""

  # Run parameters
  steps: 30
  initial_drafts: 3
  time_limit: 3600
  seed: 42
  data_preview: true
  check_data_leakage: true
  use_diff_mode: true
  use_global_memory: false
  memory_similarity_threshold: 0.7
  memory_embedding_device: cuda
  memory_embedding_model_path: "BAAI/bge-base-en-v1.5"
  fusion_vs_evolution_prob: 0.3
  branch_fusion_trigger_prob: 1.0
  max_fusion_drafts: 2

  # --------------------------------------------------------
  #  Search tree (advanced)
  # --------------------------------------------------------
  search:
    parallel_search_num: 3
    num_gpus: 1
    num_drafts: 5
    num_bugs: 1
    num_improves: 3
    topk_max_improves: 10
    max_debug_depth: 20
    back_debug_depth: 3
    debug_prob: 1
    metric_improvement_threshold: 0.0001
    max_improve_failure: 3
    branch_stagnation_threshold: 3
    topk_stagnation_threshold: 6
    stagnation_window: 4
    top_candidates_size: 20
    explore_switch_start: 0.5
    explore_switch_end: 0.7
    min_exploration_weight: 0.2
    topk_early_k: 5
    topk_early_max_per_branch: 3
    topk_late_k: 3
    topk_late_max_per_branch: 2
    force_backprop_late_threshold: 0.80
    force_backprop_late_prob: 0.5
    force_backprop_mid_threshold: 0.4
    force_backprop_mid_modulo: 3
    recent_best_window: 4
    fusion_min_time_hours: 6
    fusion_max_time_hours: 10
    fusion_min_successful_nodes: 2
    fusion_min_branches: 2

  decay:
    exploration_constant: 1.414
    lower_bound: 0.5
    alpha: 0.01
    phase_ratios: [0.3, 0.7]

# ============================================================
#  Code execution
# ============================================================
exec:
  timeout: 1800

# ============================================================
#  Resources
# ============================================================
start_cpu_id: 0
cpu_number: 21

# ============================================================
#  Model paths
# ============================================================
torch_hub_dir: ""
pretrain_model_dir: ""

# ============================================================
#  Cold-start knowledge
# ============================================================
coldstart:
  use_coldstart: true
  task_json_path: ""   # resolved at runtime
  model_json_path: ""  # resolved at runtime
  description: ""

# ============================================================
#  Runtime — set programmatically, do not edit
# ============================================================
data_dir: null
dataset_dir: ""
desc_file: null
goal: null
eval: null
exp_name: null
exp_id: ""
log_dir: ./runs
log_level: INFO
workspace_dir: ./runs
preprocess_data: true
copy_data: false
use_grading_server: false
